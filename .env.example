NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# v2 ЛК (сопровождение): encrypts students' university portal passwords at rest.
# 32 random bytes, base64: openssl rand -base64 32. Changing it makes stored passwords unreadable.
LK_SECRET_KEY=
# ЛК storage: Supabase table public.lk + bucket lk-photos by default
# (supabase/migrations/002_lk.sql). LK_STORE=file keeps a local .data/lk.json.
# LK_STORE=file
